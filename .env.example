# InsForge (Vite)
# URL do projeto: campo `oss_host` em .insforge/project.json
VITE_INSFORGE_URL=https://<appkey>.<region>.insforge.app
# Chave pública (anon) do projeto. Nunca use a API key admin no frontend.
VITE_INSFORGE_ANON_KEY=<anon-key>

# Use `true` para forçar as fixtures de demonstração sem consultar o InsForge.
VITE_USE_MOCK=false
